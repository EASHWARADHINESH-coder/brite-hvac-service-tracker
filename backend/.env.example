# PostgreSQL connection
DATABASE_URL=postgresql+psycopg://service:service@localhost:5432/service_tracker

# App
APP_NAME=Service Tracker
ENV=development
SEED_DEMO_DATA=true

# Auth (Phase 4)
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI layer (Phase 5) — optional. Leave AI_ENABLED=false to run ranking / delivery-note /
# assistant / agent on deterministic logic only. Turn it on and pick a free provider:
#
#   AI_PROVIDER=groq    -> cloud free tier; set GROQ_API_KEY (free at console.groq.com/keys)
#   AI_PROVIDER=ollama  -> fully local & offline; run `ollama serve` + `ollama pull <model>`,
#                          no key needed. Good when you want zero cloud dependency.
AI_ENABLED=false
AI_PROVIDER=groq
AI_TIMEOUT_SECONDS=30

# Groq (cloud)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Ordered local fallback models tried if the primary fails (comma-separated Ollama tags).
OLLAMA_FALLBACK_MODELS=qwen2.5:3b,gemma2:2b
# Local-only failover by default. true = also fall back to Groq (cloud) after all local models.
AI_CLOUD_FAILOVER=false

# Remote MCP server over HTTP (Phase 7). Off unless a token is set. When enabled, the read-only
# CRM tools are exposed at /mcp for MCP clients (Claude Desktop), requiring Authorization: Bearer.
MCP_HTTP_ENABLED=false
MCP_TOKEN=
