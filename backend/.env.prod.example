# Production environment (copy to backend/.env.prod on the server; never commit the real file).

APP_NAME=Service Tracker
ENV=production

# SQLite on the mounted Docker volume. (Also set in docker-compose.prod.yml — keep in sync.)
DATABASE_URL=sqlite:////data/prod.db

# Seeds master data only (skills / complaints / materials). No demo transactions exist in code,
# so leaving this true just guarantees the masters are present. Idempotent.
SEED_DEMO_DATA=true

# Auth — REQUIRED: replace with a long random secret before deploying.
#   generate one with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_use_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── AI layer — ZERO API COST ──────────────────────────────────────────────────
# RECOMMENDED (search-only): fully free AND fully private — nothing leaves the server.
# Turns on semantic search + "similar tickets" (RAG) using the local Ollama embedder.
# No chat model is pulled, so the assistant simply falls back to deterministic answers.
# Needs only ~1 GB RAM for the embedder. After deploy, build the index once: POST /ai/reindex.
AI_ENABLED=true
AI_PROVIDER=ollama

# Embeddings always come from Ollama (local, free). OLLAMA_BASE_URL is set to
# http://ollama:11434 by docker-compose.prod.yml — don't override it here.
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Add the AI assistant later (optional — pick ONE by your VPS RAM) ────────────
#  A) Fully local + private (needs ~2-3 GB RAM on top of the embedder, slower on CPU):
#       keep AI_PROVIDER=ollama, set OLLAMA_MODEL=llama3.2:3b (or gemma2:2b on <6 GB),
#       and add `ollama pull llama3.2:3b` to the ollama-pull step in docker-compose.prod.yml.
#  B) Free + fast, no server RAM (the prompt incl. grounding facts goes to Groq's free tier):
#       set AI_PROVIDER=groq and a free GROQ_API_KEY from https://console.groq.com/keys .
# OLLAMA_MODEL=llama3.2:3b
GROQ_API_KEY=

# Remote MCP server over HTTP (Phase 7). Set a long random token (openssl rand -hex 32) and
# MCP_HTTP_ENABLED=true to expose the CRM tools at <site>/mcp for MCP clients. Requires the
# Authorization: Bearer <MCP_TOKEN> header.
MCP_HTTP_ENABLED=false
MCP_TOKEN=
