# Production environment (copy to backend/.env.prod on the server; never commit the real file).

APP_NAME=Service Tracker
ENV=production

# SQLite on the mounted Docker volume. (Also set in docker-compose.prod.yml — keep in sync.)
DATABASE_URL=sqlite:////data/prod.db

# Seeds master data only (skills / complaints / materials). No demo transactions exist in code,
# so leaving this true just guarantees the masters are present. Idempotent.
SEED_DEMO_DATA=true

# Auth — REQUIRED: replace with a long random secret before deploying.
#   generate one with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_use_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI layer. Set AI_ENABLED=true to turn on semantic search / RAG (the compose file runs an
# Ollama service + pulls the embedder, so this works with no host setup).
AI_ENABLED=false

# Embeddings always come from Ollama (local, free) regardless of the chat provider below.
# OLLAMA_BASE_URL is set to http://ollama:11434 by docker-compose.prod.yml — don't override it.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Chat model for the assistant's wording (separate from embeddings). Pick one:
#   AI_PROVIDER=groq   -> cloud free tier, no server RAM; set GROQ_API_KEY (recommended on a VPS)
#   AI_PROVIDER=ollama -> local chat model; also add `ollama pull llama3.2:3b` to ollama-pull,
#                         and note a chat model needs ~2GB+ RAM (embedder alone needs ~1GB)
AI_PROVIDER=groq
GROQ_API_KEY=
